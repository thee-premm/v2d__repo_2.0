# Vote2Dine API configuration. Copy to .env and fill in real values.
# Never commit .env. Values already set in the process environment take precedence.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=5000
# LOG_LEVEL=debug               # debug | info | warn | error (default: debug in dev, info in prod)

# --- PostgreSQL ------------------------------------------------------------
# Either a full URL ...
# DATABASE_URL=postgres://v2d_app:change-me@localhost:5432/v2d_db
# ... or individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=v2d_db
DB_USER=postgres
DB_PASSWORD=
# DB_SSL=false
# DB_POOL_MAX=10

# --- Security --------------------------------------------------------------
# Required in production: at least 32 random characters. Used to sign meal
# passes and to key one-time activation/reset codes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# Public URL of the web app (used for CSRF origin checks and links in emails).
APP_ORIGIN=http://localhost:5173
# Extra origins allowed to call the API with cookies (comma-separated). Usually empty:
# in development Vite proxies /api, in production Express serves the frontend.
CORS_ORIGINS=
# Set when running behind a reverse proxy (number of hops, e.g. 1).
TRUST_PROXY=false
# Cookies are Secure (HTTPS-only) by default in production.
# COOKIE_SECURE=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# --- Background scheduler (cutoff locking, forecasts, service windows, reminders)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# --- Email -----------------------------------------------------------------
# log      development only: reset emails are written to the server log
# disabled no email is sent (default in production; admins issue reset codes instead)
MAIL_TRANSPORT=log

# --- Frontend --------------------------------------------------------------
# Built frontend to serve from the API (defaults to ../v2d_Frontend/dist when present).
# FRONTEND_DIST=../v2d_Frontend/dist

# --- Legacy (no longer used) ----------------------------------------------
# JWT_SECRET, JWT_EXPIRES_IN, REDIS_HOST, REDIS_PORT, REDIS_PASSWORD were used by
# the previous implementation and are ignored. Sessions are server-side; Redis is not required.
